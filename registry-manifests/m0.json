{
  "module": "m0",
  "base_url": "http://m0:8010",
  "tools": [
    {
      "name": "data_import_run",
      "description": "m0 数据建设：统一接收多文件（多格式×多内容类型：订单/采购/BOM/SOP/工程图/ID图/库存/设备/模具/规格书/混合归档），按 七层管道 摄入→分类→解析→实体→匹配 建批次。压缩包自动解压递归；伪扩展名/坏文件隔离不中止整批；低置信与实体冲突进入待人工确认。返回批次 id 与状态。",
      "http": {
        "method": "POST",
        "path": "/api/m0/import/upload?wait=false",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "required": ["files"],
        "properties": {
          "files": {
            "type": "array",
            "description": "Base64 文件对象数组；每个对象转换为同名 files multipart 字段。",
            "items": {
              "type": "object",
              "required": ["filename", "content_b64"],
              "properties": {
                "filename": { "type": "string" },
                "content_type": { "type": "string" },
                "content_b64": { "type": "string", "contentEncoding": "base64" }
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "description": "ready | awaiting_review | failed" }
        }
      },
      "execution": "sync",
      "side_effect": "local_write",
      "review_gate": "candidate"
    },
    {
      "name": "data_import_status",
      "description": "查询导入批次状态与候选裁决计数。文档级明细（逐候选记录）见 data_import_preview。",
      "http": {
        "method": "GET",
        "path": "/api/m0/import/batch/{batch_id}",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "required": ["batch_id"],
        "properties": {
          "batch_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "batch_id": { "type": "string" },
          "status": { "type": "string" },
          "task_id": { "type": "string" },
          "candidates": { "type": "object", "description": "按候选状态聚合的计数。" },
          "canonical": { "type": "boolean", "description": "是否读写 canonical 库（YUNPAI_M0_DB）；false=本地沙箱。" },
          "environment": { "type": "string" }
        }
      },
      "execution": "sync"
    },
    {
      "name": "data_import_preview",
      "description": "入库前预览候选文档明细（candidate_id/文件名/sha256/文档类型/置信度/审核状态/候选记录）。隔离区见 data_import_quarantine。",
      "http": {
        "method": "GET",
        "path": "/api/m0/import/batch/{batch_id}/preview",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "required": ["batch_id"],
        "properties": {
          "batch_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "batch_id": { "type": "string" },
          "documents": { "type": "array" },
          "canonical": { "type": "boolean" },
          "environment": { "type": "string" }
        }
      },
      "execution": "sync"
    },
    {
      "name": "data_import_resolve",
      "description": "人工裁决：批准/拒绝实体冲突（同码不同名/同码不同单位）或匹配候选。裁决后批次状态重算。",
      "http": {
        "method": "POST",
        "path": "/api/m0/import/batch/{batch_id}/resolve/{kind}",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "required": ["batch_id", "kind", "id", "action"],
        "properties": {
          "batch_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["entity", "mapping"] },
          "id": { "type": "integer" },
          "action": { "type": "string", "enum": ["approve", "reject"] }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "status": { "type": "string" }
        }
      },
      "execution": "sync",
      "side_effect": "local_write",
      "review_gate": "candidate"
    },
    {
      "name": "data_import_commit",
      "description": "提交入库：approved 行写入 v1 主数据（订单/库存/BOM/文档），全程 ledger 可回滚。存在未裁决冲突/低置信文档时拒绝。",
      "http": {
        "method": "POST",
        "path": "/api/m0/import/batch/{batch_id}/commit",
        "timeout_s": 120
      },
      "input_schema": {
        "type": "object",
        "required": ["batch_id"],
        "properties": {
          "batch_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "master_counts": { "type": "object" }
        }
      },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "data"
    },
    {
      "name": "data_import_rollback",
      "description": "按 ledger 回滚批次全部主数据写入，证据文件保留。",
      "http": {
        "method": "POST",
        "path": "/api/m0/import/batch/{batch_id}/rollback",
        "timeout_s": 120
      },
      "input_schema": {
        "type": "object",
        "required": ["batch_id"],
        "properties": {
          "batch_id": { "type": "string" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "batch_id": { "type": "string" },
          "status": { "type": "string" },
          "actor": { "type": "string" },
          "rolled_back": { "type": "integer", "description": "回滚的实体版本数。" },
          "rolled_back_entities": { "type": "integer", "description": "deprecated：同 rolled_back，保留历史键兼容。" },
          "canonical": { "type": "boolean" },
          "environment": { "type": "string" }
        }
      },
      "execution": "sync",
      "side_effect": "local_write",
      "review_gate": "candidate"
    },
    {
      "name": "data_import_history",
      "description": "历史导入批次列表。",
      "http": {
        "method": "GET",
        "path": "/api/m0/import/batches",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "default": 50 }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "batches": { "type": "array" }
        }
      },
      "execution": "sync"
    },
    {
      "name": "data_import_quarantine",
      "description": "隔离区文件列表（坏文件/伪扩展名/未分类），按租户返回。",
      "http": {
        "method": "GET",
        "path": "/api/m0/import/quarantine",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "default": 100 }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "quarantined": { "type": "array", "description": "deprecated：同 items，保留历史实现键兼容。" },
          "count": { "type": "integer" },
          "canonical": { "type": "boolean" },
          "environment": { "type": "string" }
        }
      },
      "execution": "sync"
    },
    {
      "name": "data_catalog_ingest_validate",
      "description": "校验 m0.ingest.v1 标准数据，不写数据库。检查稳定编码、版本、来源哈希、证据、审核状态、产品引用、产品族关系和 TaskID 范围内幂等冲突，返回 dry-run 报告。",
      "http": {
        "method": "POST",
        "path": "/api/m0/catalog/ingest/validate",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "required": ["records"],
        "properties": {
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["schema_version", "tenant_id", "idempotency_key", "source", "entity_type", "identity", "payload", "evidence", "review_status"]
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" }
        }
      },
      "execution": "sync"
    },
    {
      "name": "data_catalog_ingest_publish",
      "description": "发布已审核的 m0.ingest.v1 标准数据。在一个事务内写入规范实体版本、来源证据和 Tracking Outbox；相同 TaskID+幂等键+载荷返回 duplicate，不同载荷返回冲突。低层通用入口：不落派生关系边（has_bom/contains_material 等），单类型实体写入请优先用 m0_*_import facade（含派生关系/回填/BOM 抢占）。",
      "http": {
        "method": "POST",
        "path": "/api/m0/catalog/ingest/publish",
        "timeout_s": 120
      },
      "input_schema": {
        "type": "object",
        "required": ["records"],
        "properties": {
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["schema_version", "tenant_id", "idempotency_key", "source", "entity_type", "identity", "payload", "evidence", "review_status"]
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" }
        }
      },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_products_import",
      "description": "M0 canonical 产品导入 facade。只接受已审核的 m0.ingest.v1 product 记录，并在 canonical transaction 中写入实体、版本、来源和 projection Outbox。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/products/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_orders_import",
      "description": "M0 canonical 订单导入 facade。订单行和产品引用在同一 canonical transaction 中校验并写入。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/orders/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_boms_import",
      "description": "M0 canonical BOM 导入 facade。BOM 头、物料身份、BOM 行、来源证据和 projection Outbox 使用同一事务；同产品 active 版本抢占。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/boms/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_materials_import",
      "description": "M0 canonical 物料导入 facade。物料编码为稳定身份（不可带版本），name/unit/spec/aliases 进入同一 canonical 事务；发布后可通过 where-used 反查使用该物料的 BOM 与产品。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/materials/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_suppliers_import",
      "description": "M0 canonical 供应商导入 facade。供应商编码为稳定身份，name/legal_id/status 与声明的供应物料编码（material_codes）进入同一 canonical 事务；物料入规范后自动回填 supplied_by 关系。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/suppliers/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_equipment_import",
      "description": "M0 canonical 设备导入 facade。设备编码为稳定身份，name/equipment_type/line/status 进入同一 canonical 事务；工艺路线与工序实体接入后用于工序-设备反查。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/equipment/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_routes_import",
      "description": "M0 canonical 工艺路线导入 facade。route_code+revision 为版本化身份，product_code 必须已是规范实体；operations 携带 sequence_no、工序/物料/设备/工装编码，未入规范的端点关系静默降级。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/routes/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_operations_import",
      "description": "M0 canonical 工序导入 facade。工序编码为稳定身份，name/standard_time/status 进入同一 canonical 事务；发布后回填 has_operation 及工序-物料/设备/工装边。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/operations/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "m0_tooling_import",
      "description": "M0 canonical 工装导入 facade。工装编码为稳定身份，name/tooling_type/status 进入同一 canonical 事务；发布后回填 requires_tooling 边。入口定位：typed 直发 facade，与 data_import_run+data_import_commit 的批次人工裁决链并列；主链 workflows 未调用，需显式选择。",
      "http": { "method": "POST", "path": "/api/m0/v1/tooling/import", "timeout_s": 120 },
      "input_schema": { "type": "object", "required": ["records"], "properties": { "records": { "type": "array", "minItems": 1 } } },
      "output_schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "type": "object" } } },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "data_catalog_file_validate",
      "description": "把版本化 CSV/Excel 模板转换为 m0.ingest.v1 后执行 dry-run。支持 m0.product.v1、m0.product-family.v1、m0.order.v1、m0.bom.v1、m0.document.v1、m0.material.v1、m0.supplier.v1、m0.equipment.v1、m0.route.v1、m0.operation.v1、m0.tooling.v1；缺稳定编码、修订或未知列时拒绝，不从文件名或 Sheet 名猜业务身份。",
      "http": {
        "method": "POST",
        "path": "/api/m0/catalog/ingest/files/validate",
        "timeout_s": 60
      },
      "input_schema": {
        "type": "object",
        "required": ["file", "template_version", "source_system", "source_external_id"],
        "properties": {
          "file": {
            "type": "object",
            "required": ["filename", "content_b64"],
            "properties": {
              "filename": { "type": "string" },
              "content_type": { "type": "string" },
              "content_b64": { "type": "string", "contentEncoding": "base64" }
            }
          },
          "template_version": { "type": "string", "enum": ["m0.product.v1", "m0.product-family.v1", "m0.order.v1", "m0.bom.v1", "m0.document.v1", "m0.material.v1", "m0.supplier.v1", "m0.equipment.v1", "m0.route.v1", "m0.operation.v1", "m0.tooling.v1"] },
          "source_system": { "type": "string" },
          "source_external_id": { "type": "string" },
          "review_status": { "type": "string", "enum": ["candidate", "approved", "rejected"], "default": "candidate" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" }
        }
      },
      "execution": "sync"
    },
    {
      "name": "data_catalog_file_publish",
      "description": "把已审核的版本化 CSV/Excel 模板先转换为 m0.ingest.v1，再在同一规范发布服务中写实体版本、证据、产品索引关系和 Tracking Outbox。",
      "http": {
        "method": "POST",
        "path": "/api/m0/catalog/ingest/files/publish",
        "timeout_s": 120
      },
      "input_schema": {
        "type": "object",
        "required": ["file", "template_version", "source_system", "source_external_id", "review_status"],
        "properties": {
          "file": {
            "type": "object",
            "required": ["filename", "content_b64"],
            "properties": {
              "filename": { "type": "string" },
              "content_type": { "type": "string" },
              "content_b64": { "type": "string", "contentEncoding": "base64" }
            }
          },
          "template_version": { "type": "string", "enum": ["m0.product.v1", "m0.product-family.v1", "m0.order.v1", "m0.bom.v1", "m0.document.v1", "m0.material.v1", "m0.supplier.v1", "m0.equipment.v1", "m0.route.v1", "m0.operation.v1", "m0.tooling.v1"] },
          "source_system": { "type": "string" },
          "source_external_id": { "type": "string" },
          "review_status": { "type": "string", "const": "approved" }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" }
        }
      },
      "execution": "sync",
      "side_effect": "external_write",
      "review_gate": "candidate"
    },
    {
      "name": "data_catalog_document_candidate_validate",
      "description": "把 m0.document-candidate.v1 解析候选转换为 m0.ingest.v1 文档记录并 dry-run。文档号、修订、角色、产品编码和证据缺一即拒绝，不按标题、文件名或名称猜产品。",
      "http": {
        "method": "POST",
        "path": "/api/m0/catalog/ingest/document-candidates/validate",
        "timeout_s": 30
      },
      "input_schema": {
        "type": "object",
        "required": ["candidates"],
        "properties": {
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
